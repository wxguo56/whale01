# 运行模式：mock | deepseek。未配置 DEEPSEEK_API_KEY 时默认 mock。
MODEL_MODE=mock
PORT=8787

# DeepSeek（只在后端保存，禁止写入客户端或仓库）
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_API_KEY=
MODEL_TIMEOUT_MS=30000

# 编排上限
MAX_MODEL_CALLS=5
MAX_TOOL_BATCHES=3

# 可选覆盖数据路径
# OPERATION_LOG_PATH=./data/operations.jsonl
# REMINDERS_PATH=./data/reminders.json

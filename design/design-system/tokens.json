{
  "$schema": "design-tokens-v1",
  "product": "代号鲸鱼01 (Whale01)",
  "version": "1.0.0",
  "date": "2026-11-10",
  "status": "canonical-design-system",
  "basis": {
    "direction": "B 折光 PRISM（极简修订版）",
    "references": [
      "21_新版UI与交互设计方案.md（布局与原生映射基线）",
      "22_三套差异化UI对比方案.md（B方向视觉）",
      "23_统一输入与语音入口修订.md（底部统一输入规则）",
      "25_极简单主页设计任务书.md（当前最新方向）"
    ],
    "defaultTheme": "dark",
    "defaultThemeReason": "B 方向以深石墨为默认；浅色为完整对等主题，非降级版"
  },
  "referenceDevice": {
    "name": "iPhone 16 Pro",
    "widthPt": 402,
    "heightPt": 874,
    "note": "原型画布参考；原生一律使用真实 safeArea，不复制外壳/灵动岛"
  },

  "color": {
    "dark": {
      "bg-page":            "#111C22",
      "bg-surface":         "#1C2C34",
      "bg-surface-raised":  "#223540",
      "bg-input":           "#16242C",
      "bg-overlay":         "rgba(10,16,20,0.55)",
      "text-primary":       "#EEF5F6",
      "text-secondary":     "#AFBEC7",
      "text-tertiary":      "#7E939E",
      "text-on-accent":     "#0E2A26",
      "accent":             "#A6EBDD",
      "accent-pressed":     "#8AD9C9",
      "accent-muted":       "rgba(166,235,221,0.16)",
      "separator":          "#2A3D47",
      "status-success":     "#8FD9B0",
      "status-warning":     "#EFC97F",
      "status-error":       "#F09A8E",
      "status-info":        "#9CC8F0",
      "status-pending":     "#C9B7E8"
    },
    "light": {
      "bg-page":            "#E9EFF0",
      "bg-surface":         "#F7FAF9",
      "bg-surface-raised":  "#FFFFFF",
      "bg-input":           "#EFF4F4",
      "bg-overlay":         "rgba(32,53,60,0.45)",
      "text-primary":       "#20353C",
      "text-secondary":     "#526971",
      "text-tertiary":      "#7C9199",
      "text-on-accent":     "#FFFFFF",
      "accent":             "#246453",
      "accent-pressed":     "#1B5041",
      "accent-muted":       "rgba(36,100,83,0.12)",
      "separator":          "#D3DEE0",
      "status-success":     "#2E7D53",
      "status-warning":     "#9A6B12",
      "status-error":       "#B3402F",
      "status-info":        "#2C639B",
      "status-pending":     "#6B4FA0"
    }
  },

  "typography": {
    "fontFamily": "system-ui（SF Pro / 苹方，跟随系统动态字体）",
    "scale": {
      "largeTitle":  { "sizePt": 28, "weight": 600, "usage": "主页问候、页面大标题" },
      "title":       { "sizePt": 25, "weight": 600, "usage": "页面标题、sheet 标题" },
      "cardTitle":   { "sizePt": 17, "weight": 600, "usage": "卡片标题、按钮主要文字" },
      "body":        { "sizePt": 17, "weight": 400, "usage": "对话正文、卡片正文（基准字号）" },
      "secondary":   { "sizePt": 14, "weight": 400, "usage": "次级说明、来源、时间" },
      "caption":     { "sizePt": 12, "weight": 500, "usage": "标签、状态徽章（不承载关键信息）" },
      "mono":        { "sizePt": 12, "weight": 500, "usage": "小型等宽辅助标签（编号、口径说明）" }
    },
    "lineHeight": "正文 1.45；标题 1.2",
    "rules": [
      "必要的时间和金额不得压缩为小字",
      "全部文字支持动态字体放大与换行",
      "关键日期/时间/金额使用 body 或 cardTitle，不用 caption"
    ]
  },

  "spacing": {
    "baseUnit": 4,
    "scale": [4, 8, 12, 16, 20, 24, 32, 48],
    "usage": {
      "pageMarginH": 20,
      "cardPadding": 16,
      "sectionGap": "20-24",
      "itemGap": 12,
      "iconTextGap": 8
    }
  },

  "radius": {
    "card": 20,
    "control": 16,
    "chip": 999,
    "sheetTop": 28,
    "note": "v4 原型卡片圆角 23pt 统一收敛为 20pt；控件 17pt 收敛为 16pt"
  },

  "elevation": {
    "rule": "阴影只用于浮层（sheet、迷你播放器、toast）；页面内内容用背景色和分隔线分层，不加阴影",
    "overlay": "0 8 24 rgba(0,0,0,0.28)",
    "player":  "0 4 16 rgba(0,0,0,0.22)"
  },

  "hitTarget": { "minPt": 44, "note": "全部可交互元素 ≥ 44×44pt" },

  "motion": {
    "durations": { "micro": 160, "standard": 220, "sheet": 280 },
    "easing": { "standard": "cubic-bezier(0.2, 0.8, 0.2, 1)", "sheet": "cubic-bezier(0.32, 0.72, 0, 1)" },
    "patterns": {
      "messageAppear":  { "ms": "180-220", "spec": "位移6pt + 淡入" },
      "sheetOpen":      { "ms": "250-300", "spec": "轻缓曲线，保留原会话" },
      "voiceIdle":      { "ms": "3000-4000", "spec": "角色呼吸，位移≤4pt" },
      "voiceWaveform":  { "spec": "绑定真实录音/播报幅度，禁止随机波形" },
      "completion":     { "spec": "状态文字+小图标轻反馈；成功判定来自真实结果，不用计时器" }
    },
    "reduceMotion": "关闭漂浮、光效、呼吸等连续装饰动画；保留文字与图标状态变化"
  },

  "states": {
    "taskLifecycle": ["idle", "listening", "thinking", "executing", "waiting_user", "completed", "failed", "cancelled"],
    "resultStatus": ["success", "failed", "needs_input", "needs_authorization", "needs_confirmation", "opened_external_app", "execution_unknown", "cancelled", "unsupported"],
    "inputMode": ["text", "voice"],
    "statusStyle": "图标 + 文字 + 色调三重表达；不只用颜色区分状态"
  },

  "icons": {
    "style": "统一线条图标；原生优先 SF Symbols",
    "brand": "原创鲸鱼为可缩放矢量资产；角色面积小，仅语音/状态时成为视觉中心"
  },

  "nativeMapping": {
    "tabNavigation": "无常驻底部导航；主页顶部 任务/设置 轻量入口",
    "conversation": "ScrollView/LazyVStack，保留阅读位置",
    "inputBar": "safeAreaInset 底部布局，贴键盘上沿",
    "confirm": "sheet + 系统 detent",
    "voice": "fullScreenCover，绑定真实 ASR/Agent/TTS 阶段",
    "preferences": "Form 分组列表"
  }
}

  "product": "代号鲸鱼01 (Whale01)",
  "version": "6.0.0",
  "date": "2026-11-10",
  "status": "design-candidates-awaiting-selection",
  "basis": {
    "sharedBoard": "design/design-system/tokens.json v1.0（极简单主页骨架 + 统一输入区，作为五套共同底板）",
    "stylePhilosophy": "乔布斯式 iOS 设计：Clarity 清晰 / Deference 让位内容 / Depth 真实层次；单一强调色、大字号排版、真实深度而非装饰、内容即界面",
    "references": [
      "25_极简单主页设计任务书（主页骨架）",
      "23_统一输入与语音入口修订（交互规则，五套全部继承）",
      "26_设计规范系统.md（底板规范）"
    ]
  },
  "referenceDevice": { "name": "iPhone 16 Pro", "widthPt": 402, "heightPt": 874 },
  "sharedRules": {
    "bodyFontPt": 17,
    "minHitAreaPt": 44,
    "homeLayout": "top-brand-and-2-entries / centered-empty-state / bottom-unified-input",
    "emptyStateText": "有什么想聊的？",
    "inputPlaceholder": "给鲸鱼发消息…",
    "entryTexts": ["任务", "设置"],
    "interaction": "23号验收 1-5 全部继承：唯一语音入口、语音/发送分离、空白不提交、会话草稿保留",
    "statusStyle": "图标+文字+色调，不只用颜色",
    "shadowRule": "阴影只给浮层；各方向深度表现手法不同但页面内容仍不加整卡阴影"
  },
